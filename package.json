{
  "name": "document-intelligence-assurance-hub",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "format": "prettier --write --ignore-unknown README.md docs/architecture.md docs/evaluation-report.md docs/privacy-and-retention.md docs/deployment-checklist.md docs/walkthrough-script.md scripts/verify-public-surface.mjs scripts/record-walkthrough.mjs next.config.ts package.json vercel.json",
    "format:check": "prettier --check --ignore-unknown README.md docs/architecture.md docs/evaluation-report.md docs/privacy-and-retention.md docs/deployment-checklist.md docs/walkthrough-script.md scripts/verify-public-surface.mjs scripts/record-walkthrough.mjs next.config.ts package.json vercel.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.contract.json",
    "lint": "eslint .",
    "build": "next build",
    "build:production": "next build",
    "design:lint": "npx -p @google/design.md designmd lint DESIGN.md",
    "verify:premium": "node scripts/premium-audit.mjs",
    "verify:public": "node scripts/verify-public-surface.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "record:walkthrough": "node scripts/record-walkthrough.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/openai": "^4.0.50",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.83",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
